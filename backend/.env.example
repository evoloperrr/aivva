APP_NAME=AIVVA
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:48100
FRONTEND_URL=http://127.0.0.1:43123

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=aivva
DB_USERNAME=aivva
DB_PASSWORD=aivva_dev

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@aivva.world"
MAIL_FROM_NAME="${APP_NAME}"

SANCTUM_STATEFUL_DOMAINS=127.0.0.1:43123,localhost:43123
CORS_ALLOWED_ORIGINS=http://127.0.0.1:43123,http://localhost:43123

# Leave empty to use the built-in heuristic civilization brain.
# --live genesis requires OPENAI_API_KEY. Never commit a real key.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
AIVVA_BRAIN_MODE=HEURISTIC
AIVVA_PEER_PROVIDER=heuristic

STARTER_CREDITS=100
AIVVA_TICK_SECONDS=4
AIVVA_TRAVEL_SECONDS_PER_UNIT=0.08
